# Backend environment (P4-01). Copy to .env and fill in. Timings/weights live in the DB (D8), not here.
NODE_ENV=development
PORT=4000

# PostgreSQL (points at the local-postgres container; dev password is `password123`).
# Use a secret manager / real credentials in non-local environments.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.xsdllqgvzmgmjrvzwoun:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.xsdllqgvzmgmjrvzwoun:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Redis (used by BullMQ jobs — later phase)
# REDIS_URL=redis://localhost:6379

# Auth (JWT). The dev values below are PUBLIC placeholders for local use only.
# In production the app REFUSES TO BOOT unless each secret is overridden with a strong value
# of at least 32 characters (enforced in src/config/env.ts). Generate one with e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# CORS origin of the frontend
CORS_ORIGIN=http://localhost:5173

# Trust X-Forwarded-For for the client IP. Turn this on ONLY when the app really sits behind a
# proxy/load balancer: there, without it, every request shares one rate-limit key (the proxy's IP)
# and the per-IP auth limiters stop working. With no proxy in front, leaving it off is what stops a
# caller forging the header to get a fresh rate-limit bucket per request.
TRUST_PROXY=false

LOG_LEVEL=info
