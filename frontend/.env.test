# Committed test-only override (see .gitignore exception). Vite loads this automatically
# when running under Vitest (mode=test).
#
# The app's default client base URL is relative ('/api/v1'), which the native fetch
# Request implementation used by Node/jsdom cannot parse (it has no document base URL to
# resolve against, unlike a real browser). Point the client at an absolute origin instead;
# MSW's relative-path handlers still match it, because they're resolved against jsdom's
# `location` (see the matching `environmentOptions.jsdom.url` in vite.config.ts).
VITE_API_BASE_URL=http://localhost/api/v1
