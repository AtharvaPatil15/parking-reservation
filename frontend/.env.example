# Frontend runtime config (Vite). Copy to `.env` for local overrides.
#
# Leave VITE_API_BASE_URL unset to run mock-first (MSW). When set, the app talks to a
# live backend instead of the mocks (used in P5-13 to wire the hero flow end-to-end).
# VITE_API_BASE_URL=/api/v1

# Where the dev-server proxy forwards /api/v1 during `npm run dev`.
# VITE_API_PROXY_TARGET=http://localhost:4000
